#include <iostream>
using namespace std;

class Solution {
public:
    string mergeAlternately(string word1, string word2) {
        string result;
        int i = 0, j = 0;
        
        // Loop through both strings and merge them alternately
        while (i < word1.length() && j < word2.length()) {
            result += word1[i++];
            result += word2[j++];
        }
        
        // If word1 is longer, append the remaining characters
        while (i < word1.length()) {
            result += word1[i++];
        }
        
        // If word2 is longer, append the remaining characters
        while (j < word2.length()) {
            result += word2[j++];
        }
        
        return result;
    }
};

int main() {
    string word1, word2;
    cout << "Enter first word: ";
    cin >> word1;
    cout << "Enter second word: ";
    cin >> word2;
    
    Solution solution;
    string mergedString = solution.mergeAlternately(word1, word2);
    
    cout << "Merged string: " << mergedString << endl;
    
    return 0;
}
